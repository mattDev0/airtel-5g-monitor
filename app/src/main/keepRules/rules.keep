# R8 keep rules for Airtel 5G Monitor v3 (AGP 9 keepRules directory).

# Preserve Kotlinx Serialization metadata and companion serializers for Navigation Compose routes.
-keepattributes *Annotation*,InnerClasses
-keepclassmembers class com.airtel.monitor.ui.navigation.** {
    *** Companion;
}
-keep,includedescriptorclasses class com.airtel.monitor.ui.navigation.**$$serializer { *; }
-keepclasseswithmembers class com.airtel.monitor.ui.navigation.** {
    kotlinx.serialization.KSerializer serializer(...);
}

# WorkManager worker & home-screen AppWidgetProviders instantiated via reflection by the OS.
-keep public class com.airtel.monitor.work.RouterMonitorWorker {
    public <init>(android.content.Context, androidx.work.WorkerParameters);
}
-keep public class * extends android.appwidget.AppWidgetProvider

# Room databases (WorkManager's WorkDatabase_Impl) are created by reflection through their no-arg constructor.
# Without this, R8 strips it and the app crashes on launch in WorkManagerInitializer.
-keep class * extends androidx.room.RoomDatabase { <init>(); }
